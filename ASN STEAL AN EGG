-- ADMIN ABUSE
------------------------------------------------------------

AdminAction.OnServerEvent:Connect(
	function(player, action, amount)

		if not IsAdmin(player) then
			return
		end

		local stats =
			player:FindFirstChild(
				"leaderstats"
			)

		if not stats then
			return
		end

		amount = tonumber(amount) or 0

		if action == "GiveCoins" then

			if amount > 0 then
				stats.Coins.Value += amount
			end

		elseif action == "GiveEgg" then

			if amount > 0 then

				for i = 1, math.min(amount,100) do

					table.insert(
						Data[player].Inventory,
						{
							Rarity = "Admin",
							Reward = 1000
						}
					)

					stats.Eggs.Value += 1
				end
			end

		elseif action == "GlobalEvent" then

			StartEvent()

		elseif action == "SpawnEgg" then

			local root =
				GetPlayerRoot(player)

			if root then
				CreateEgg(
					root.Position +
					Vector3.new(0,3,0)
				)
			end
		end
	end
)

