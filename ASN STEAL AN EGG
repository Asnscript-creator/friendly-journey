------------------------------------------------------------
-- CONFIG
------------------------------------------------------------

local Config = {
	VIP_GAMEPASS_ID = 0, -- isi ID GamePass VIP

	AUTO_REWARD_TIME = 60,
	AUTO_EVENT_TIME = 300,
	EVENT_DURATION = 120,

	EGG_DISTANCE = 25,
	TREADMILL_DISTANCE = 12,
	MAX_INVENTORY = 100,

	TREADMILL_REWARD = 2,
	AUTO_REWARD = 50,
	EVENT_REWARD = 500,
	VIP_MULTIPLIER = 2,

	EGG_RARITY = {
		{Name = "Common", Chance = 60, Reward = 10},
		{Name = "Uncommon", Chance = 25, Reward = 25},
		{Name = "Rare", Chance = 10, Reward = 75},
		{Name = "Epic", Chance = 4, Reward = 200},
		{Name = "Legendary", Chance = 0.9, Reward = 1000},
		{Name = "Mythic", Chance = 0.1, Reward = 10000},
	}
}

-- Ganti dengan UserId kamu
local ADMINS = {
	[123456789] = true,
}

------------------------------------------------------------
-- REMOTES
------------------------------------------------------------

local Remotes = Instance.new("Folder")
Remotes.Name = "StealEggRemotes"
Remotes.Parent = ReplicatedStorage

local function Remote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = Remotes
	return r
end

local CollectEgg = Remote("CollectEgg")
local StealEgg = Remote("StealEgg")
local ToggleSetting = Remote("ToggleSetting")
local StartEvent = Remote("StartEvent")
local AdminAction = Remote("AdminAction")

------------------------------------------------------------
-- DATA
------------------------------------------------------------

local Store = DataStoreService:GetDataStore("StealEgg_V2")
local Data = {}

local DefaultData = {
	Coins = 0,
	Eggs = 0,
	StolenEggs = 0,

	Inventory = {},

	Settings = {
		AutoCollect = false,
		AutoReward = true,
		AutoEvent = false,
		VisualEgg = true,
		VisualEvent = true,
	}
}

local function CopyTable(t)
	local new = {}

	for k,v in pairs(t) do
		if type(v) == "table" then
			new[k] = CopyTable(v)
		else
			new[k] = v
		end
	end

	return new
end

------------------------------------------------------------
-- RARITY
------------------------------------------------------------

local function GetRarity()

	local roll = math.random() * 100
	local total = 0

	for _, rarity in ipairs(Config.EGG_RARITY) do

		total += rarity.Chance

		if roll <= total then
			return rarity
		end
	end

	return Config.EGG_RARITY[1]
end

------------------------------------------------------------
-- ADMIN
------------------------------------------------------------

local function IsAdmin(player)
	return ADMINS[player.UserId] == true
end

------------------------------------------------------------
-- STATS
------------------------------------------------------------

local function CreateStats(player, data)

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local Coins = Instance.new("IntValue")
	Coins.Name = "Coins"
	Coins.Value = data.Coins
	Coins.Parent = leaderstats

	local Eggs = Instance.new("IntValue")
	Eggs.Name = "Eggs"
	Eggs.Value = data.Eggs
	Eggs.Parent = leaderstats

	local Stolen = Instance.new("IntValue")
	Stolen.Name = "StolenEggs"
	Stolen.Value = data.StolenEggs
	Stolen.Parent = leaderstats
end

------------------------------------------------------------
-- LOAD DATA
------------------------------------------------------------

local function Load(player)

	local data

	local success, result = pcall(function()
		return Store:GetAsync("Player_" .. player.UserId)
	end)

	if success and result then
		data = result
	else
		data = CopyTable(DefaultData)
	end

	Data[player] = data

	CreateStats(player, data)

	--------------------------------------------------------
	-- VIP
	--------------------------------------------------------

	local vip = false

	if Config.VIP_GAMEPASS_ID > 0 then

		pcall(function()
			vip = MarketplaceService:UserOwnsGamePassAsync(
				player.UserId,
				Config.VIP_GAMEPASS_ID
			)
		end)
	end

	player:SetAttribute("VIP", vip)

	--------------------------------------------------------
	-- PRIVATE SERVER
	--------------------------------------------------------

	player:SetAttribute(
		"PrivateServer",
		game.PrivateServerId ~= ""
	)
end

------------------------------------------------------------
-- SAVE DATA
------------------------------------------------------------

local function Save(player)

	local data = Data[player]

	if not data then
		return
	end

	local stats = player:FindFirstChild("leaderstats")

	if stats then

		data.Coins = stats.Coins.Value
		data.Eggs = stats.Eggs.Value
		data.StolenEggs = stats.StolenEggs.Value
	end

	pcall(function()
		Store:SetAsync(
			"Player_" .. player.UserId,
			data
		)
	end)
end

------------------------------------------------------------
-- PLAYER
------------------------------------------------------------

Players.PlayerAdded:Connect(function(player)

	Load(player)

	print(player.Name .. " loaded Steal an Egg")
end)

Players.PlayerRemoving:Connect(function(player)

	Save(player)

	Data[player] = nil
end)

------------------------------------------------------------
-- CREATE EGG
------------------------------------------------------------

local function CreateEgg(position)

	local rarity = GetRarity()

	local egg = Instance.new("Part")

	egg.Name = rarity.Name .. "_Egg"
	egg.Shape = Enum.PartType.Ball
	egg.Size = Vector3.new(2,2,2)

	egg.Position = position

	egg.Anchored = true
	egg.CanCollide = false

	egg:SetAttribute("IsEgg", true)
	egg:SetAttribute("Rarity", rarity.Name)
	egg:SetAttribute("Reward", rarity.Reward)

	egg.Parent = workspace

	--------------------------------------------------------
	-- VISUAL
	--------------------------------------------------------

	local billboard = Instance.new("BillboardGui")

	billboard.Size = UDim2.new(0,150,0,50)
	billboard.StudsOffset = Vector3.new(0,3,0)
	billboard.AlwaysOnTop = true
	billboard.Parent = egg

	local label = Instance.new("TextLabel")

	label.Size = UDim2.fromScale(1,1)
	label.BackgroundTransparency = 1

	label.Text =
		"🥚 " ..
		rarity.Name ..
		"\n+" ..
		rarity.Reward ..
		" Coins"

	label.TextScaled = true
	label.Parent = billboard

	return egg
end

