local EventActive = false

local function StartEvent()

	if EventActive then
		return
	end

	EventActive = true

	print("🔥 GLOBAL EGG EVENT STARTED!")

	for player, data in pairs(Data) do

		local stats =
			player:FindFirstChild(
				"leaderstats"
			)

		if stats then

			local reward =
				Config.EVENT_REWARD

			if player:GetAttribute("VIP") then
				reward *=
					Config.VIP_MULTIPLIER
			end

			stats.Coins.Value += reward

			data.Coins =
				stats.Coins.Value
		end
	end

	task.delay(
		Config.EVENT_DURATION,
		function()

			EventActive = false

			print("🔥 GLOBAL EGG EVENT ENDED!")
		end
	)
end

